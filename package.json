{
  "name": "nomnomtokens",
  "version": "0.5.0",
  "description": "nom nom nom — your AI coding agent is eating tokens. A local-first dashboard that shows exactly how many.",
  "keywords": [
    "claude-code",
    "usage",
    "tokens",
    "dashboard",
    "local-first",
    "analytics",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "nomnomtokens": "bin/cli.js",
    "nnt": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "maplibre-gl"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikolaiKushner/nomnomtokens.git"
  },
  "homepage": "https://github.com/NikolaiKushner/nomnomtokens#readme",
  "bugs": {
    "url": "https://github.com/NikolaiKushner/nomnomtokens/issues"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "pnpm --filter @nomnomtokens/web dev",
    "build": "pnpm run build:web && pnpm run build:cli",
    "build:web": "pnpm --filter @nomnomtokens/web build && node scripts/bundle-dashboard.mjs",
    "build:cli": "tsup",
    "nnt": "pnpm --filter @nomnomtokens/cli run nnt",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.0.0"
}
